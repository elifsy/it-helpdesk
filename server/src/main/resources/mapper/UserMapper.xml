<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tzme.helpdesk.mapper.UserMapper">
  <select id="findById" resultType="com.tzme.helpdesk.domain.User">
    select * from sys_user where id = #{id}
  </select>
  <select id="findByName" resultType="com.tzme.helpdesk.domain.User">
    select * from sys_user where name = #{name} and status = 'ACTIVE' limit 1
  </select>
  <select id="findByDingId" resultType="com.tzme.helpdesk.domain.User">
    select * from sys_user where ding_user_id = #{dingUserId} limit 1
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    insert into sys_user(ding_user_id,name,employee_no,dept_id,dept_name,mobile,email,role,skill,location,status)
    values(#{dingUserId},#{name},#{employeeNo},#{deptId},#{deptName},#{mobile},#{email},#{role},#{skill},#{location},'ACTIVE')
  </insert>
  <select id="listEngineers" resultType="com.tzme.helpdesk.domain.User">
    select * from sys_user where status = 'ACTIVE' and role in ('IT','ADMIN') order by id
  </select>
  <select id="listByRole" resultType="com.tzme.helpdesk.domain.User">
    select * from sys_user where status = 'ACTIVE' and role like concat('%', #{role}, '%') order by id
  </select>
</mapper>
