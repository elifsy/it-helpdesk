# 数据库
MYSQL_ROOT_PASSWORD=root123456

# JWT：生产必须替换，长度不低于 32 字节
JWT_SECRET=tzme-helpdesk-change-this-secret-in-production-2026

# 本文件仅为模板；请将配置填写到同目录的 .env，start.cmd 实际读取 .env。
# 钉钉：本地演示保持 false，启用免登时改 true 并填全以下四项。
DINGTALK_ENABLED=false
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# 可选：初始管理员的真实钉钉 UserId（首次钉钉认证后仅初始化一次，其余用户默认为普通用户）
DINGTALK_BOOTSTRAP_ADMIN_USER_ID=

# 二维码基址：必须全员可达（内网域名或公网 HTTPS）
QRCODE_BASE_URL=http://localhost
